apiVersion: v1
kind: Pod
metadata:
  name: hostpath-demo
  namespace: kcsa-dev # Must be labeled pod-security.kubernetes.io/enforce=privileged
spec:
  containers:
  - name: log-reader
    image: busybox
    command: ["sleep", "3600"]
    volumeMounts:
    - name: host-logs
      mountPath: /host/var/log
      readOnly: true # Always enforce readOnly: true whenever possible
  volumes:
  - name: host-logs
    hostPath:
      path: /var/log # Mount the narrowest subdirectory needed, never "/"
      type: Directory # Validates the path exists and is a directory before mounting

